// cl-df-interp-spline-stage-189: Test Suite
import "../dfi_189.zk"

fn test_run():
    res := interp_stage_189(2.0, 6.0, 0.5)
    diff := res - 6.9000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
