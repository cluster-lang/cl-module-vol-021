// cl-df-interp-spline-stage-820: Test Suite
import "../dfi_820.zk"

fn test_run():
    res := interp_stage_820(2.0, 6.0, 0.5)
    diff := res - 5.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
