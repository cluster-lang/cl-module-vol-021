// cl-df-interp-spline-stage-237: Test Suite
import "../dfi_237.zk"

fn test_run():
    res := interp_stage_237(2.0, 6.0, 0.5)
    diff := res - 6.7000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-df-interp-spline-stage-237!")
