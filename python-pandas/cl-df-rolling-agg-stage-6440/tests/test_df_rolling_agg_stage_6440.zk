// cl-df-rolling-agg-stage-6440: Test Suite
import "../dfr_6440.zk"

fn test_run():
    res := rolling_step_6440(10.0, 5.0, 0.3)
    diff := res - 328.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
