// cl-df-interp-spline-stage-401: Test Suite
import "../dfi_401.zk"

fn test_run():
    res := interp_stage_401(2.0, 6.0, 0.5)
    diff := res - 3.1000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-df-interp-spline-stage-401!")
