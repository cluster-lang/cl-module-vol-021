// cl-df-rolling-agg-stage-6400: Test Suite
import "../dfr_6400.zk"

fn test_run():
    res := rolling_step_6400(10.0, 5.0, 0.3)
    diff := res - 326.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-df-rolling-agg-stage-6400!")
