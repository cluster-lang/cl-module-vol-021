// cl-df-rolling-agg-stage-5050: Test Suite
import "../dfr_5050.zk"

fn test_run():
    res := rolling_step_5050(10.0, 5.0, 0.3)
    diff := res - 259.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-df-rolling-agg-stage-5050!")
