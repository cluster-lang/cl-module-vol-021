// cl-df-rolling-agg-stage-7550: Test Suite
import "../dfr_7550.zk"

fn test_run():
    res := rolling_step_7550(10.0, 5.0, 0.3)
    diff := res - 384.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-df-rolling-agg-stage-7550!")
