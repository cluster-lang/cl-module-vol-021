// cl-df-interp-spline-stage-29: Test Suite
import "../dfi_29.zk"

fn test_run():
    res := interp_stage_29(2.0, 6.0, 0.5)
    diff := res - 5.9000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
