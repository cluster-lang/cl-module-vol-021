// cl-df-interp-spline-stage-300: Test Suite
import "../dfi_300.zk"

fn test_run():
    res := interp_stage_300(2.0, 6.0, 0.5)
    diff := res - 3.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-df-interp-spline-stage-300!")
