// cl-df-rolling-agg-stage-8032: Test Suite
import "../dfr_8032.zk"

fn test_run():
    res := rolling_step_8032(10.0, 5.0, 0.3)
    diff := res - 408.1000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-df-rolling-agg-stage-8032!")
