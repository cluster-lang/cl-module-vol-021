// cl-df-interp-spline-stage-275: Test Suite
import "../dfi_275.zk"

fn test_run():
    res := interp_stage_275(2.0, 6.0, 0.5)
    diff := res - 5.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-df-interp-spline-stage-275!")
