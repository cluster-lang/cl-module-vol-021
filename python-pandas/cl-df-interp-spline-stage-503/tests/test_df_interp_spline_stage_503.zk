// cl-df-interp-spline-stage-503: Test Suite
import "../dfi_503.zk"

fn test_run():
    res := interp_stage_503(2.0, 6.0, 0.5)
    diff := res - 3.3000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
