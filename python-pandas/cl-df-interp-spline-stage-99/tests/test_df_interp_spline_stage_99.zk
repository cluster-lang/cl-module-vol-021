// cl-df-interp-spline-stage-99: Test Suite
import "../dfi_99.zk"

fn test_run():
    res := interp_stage_99(2.0, 6.0, 0.5)
    diff := res - 7.9000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-df-interp-spline-stage-99!")
