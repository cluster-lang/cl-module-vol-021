import "../dfi_438.zk"

fn test_run():
    res := interp_stage_438(2.0, 6.0, 0.5)
    diff := res - 6.8000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
