// cl-df-interp-spline-stage-375: Test Suite
import "../dfi_375.zk"

fn test_run():
    res := interp_stage_375(2.0, 6.0, 0.5)
    diff := res - 5.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
