// cl-df-interp-spline-stage-220: Test Suite
import "../dfi_220.zk"

fn test_run():
    res := interp_stage_220(2.0, 6.0, 0.5)
    diff := res - 5.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-df-interp-spline-stage-220!")
