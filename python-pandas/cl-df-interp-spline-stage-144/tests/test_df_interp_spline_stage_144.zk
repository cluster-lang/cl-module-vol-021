// cl-df-interp-spline-stage-144: Test Suite
import "../dfi_144.zk"

fn test_run():
    res := interp_stage_144(2.0, 6.0, 0.5)
    diff := res - 7.4000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-df-interp-spline-stage-144!")
