// cl-df-rolling-agg-stage-8085: Test Suite
import "../dfr_8085.zk"

fn test_run():
    res := rolling_step_8085(10.0, 5.0, 0.3)
    diff := res - 410.7500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.01: sys_exit(1)

fn main():
    test_run()
    print("✓ All tests passed for cl-df-rolling-agg-stage-8085!")
